{
  "name": "codi-test-framework",
  "version": "2.0.0-beta",
  "description": "A simple test framework for JavaScript",
  "type": "module",
  "main": "src/_codi.js",
  "browser": "src/_codi.browser.js",
  "types": "types/codi.d.ts",
  "exports": {
    ".": {
      "browser": "./src/_codi.browser.js",
      "node": "./src/_codi.js",
      "default": "./src/_codi.js"
    },
    "./browser": "./dist/codi.browser.js"
  },
  "bin": {
    "codi": "cli.js"
  },
  "scripts": {
    "test": "npm run tests",
    "tests": "node --experimental-test-module-mocks cli.js tests --returnResults",
    "test:node-only": "node --experimental-test-module-mocks cli.js tests --node-only --returnResults",
    "test:web": "bun --bun ./tests/webfunction.js",
    "test:browser": "node cli.js tests --browser",
    "build": "node scripts/build-esbuild.js",
    "dev": "npm run build && npm run tests",
    "prepublishOnly": "npm run build",
    "postbuild": "npm run test:browser",
    "version": "bun --bun cli.js --version",
    "clean": "rm -rf dist/*.js dist/*.map",
    "check": "npm run build && npm run tests",
    "validate": "node scripts/validate-automation.js",
    "validate:ci": "npm run validate && npm run build && npm run tests"
  },
  "keywords": [
    "test",
    "framework",
    "javascript"
  ],
  "author": "Rob Hurst",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "happy-dom": "^20.7.0",
    "node-mocks-http": "^1.16.2",
    "puppeteer": "^23.0.0",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0-beta.1",
    "esbuild": "^0.19.0"
  }
}
